[gd_resource type="Resource" script_class="MapDefinition" format=3 uid="uid://ctk115uf42bkk"]

[ext_resource type="Script" uid="uid://b3ajayia7vvp" path="res://addons/metroidvania_kit/map/data/map_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://hfig1nxlqq7h" path="res://addons/metroidvania_kit/map/data/map_region.gd" id="2_region"]
[ext_resource type="Script" uid="uid://ber1bxm2jku7h" path="res://addons/metroidvania_kit/map/data/map_room.gd" id="3_room"]

[sub_resource type="Resource" id="MapRegion_main"]
script = ExtResource("2_region")
region_id = &"main"
display_name = "Main"
room_ids = Array[StringName]([&"map:level_0", &"map:level_1", &"map:level_2", &"map:level_3"])

[sub_resource type="Resource" id="MapRoom_level_0"]
script = ExtResource("3_room")
room_id = &"map:level_0"
world_room_id = &"level_0"
region_id = &"main"
map_position = Vector2i(0, 1)

[sub_resource type="Resource" id="MapRoom_level_1"]
script = ExtResource("3_room")
room_id = &"map:level_1"
world_room_id = &"level_1"
region_id = &"main"
map_position = Vector2i(2, 1)

[sub_resource type="Resource" id="MapRoom_level_2"]
script = ExtResource("3_room")
room_id = &"map:level_2"
world_room_id = &"level_2"
region_id = &"main"
map_position = Vector2i(4, 0)
map_size = Vector2i(1, 2)

[sub_resource type="Resource" id="MapRoom_level_3"]
script = ExtResource("3_room")
room_id = &"map:level_3"
world_room_id = &"level_3"
region_id = &"main"
map_position = Vector2i(6, 1)
map_size = Vector2i(2, 1)

[resource]
script = ExtResource("1_definition")
map_id = &"main"
regions = Array[Resource]([SubResource("MapRegion_main")])
rooms = Array[Resource]([SubResource("MapRoom_level_0"), SubResource("MapRoom_level_1"), SubResource("MapRoom_level_2"), SubResource("MapRoom_level_3")])
